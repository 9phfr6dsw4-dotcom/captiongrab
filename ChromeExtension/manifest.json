{
  "manifest_version": 3,
  "name": "CaptionGrab YouTube Transcript",
  "description": "Reads the English transcript shown on the YouTube page opened by CaptionGrab and sends it to the local macOS app.",
  "version": "1.2.7",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["transcript-extractor.js", "transcript-panel-opener.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
